# ============================================
# UENR E-LEARNING PLATFORM - ENVIRONMENT VARS
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
APP_NAME=UENR E-Learning Platform
APP_URL=http://localhost:3000
APP_ENV=development

# Google Gemini API (for AI quiz generation). Get a key from https://aistudio.google.com/apikey
# Leave empty to fall back to mock quizzes.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Groq (OpenAI-compatible) — preferred provider when set. Get a key from https://console.groq.com/keys
# When empty, the service falls back to Gemini.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Data API (for resource recommendations)
YOUTUBE_API_KEY=your-youtube-api-key-here
