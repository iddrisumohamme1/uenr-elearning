# ============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it holds the service role key (full DB access).
# ============================================

# From Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App
APP_ENV=development

# Heavy ML switches. Keep False on small instances (Render 512 MB) so
# TensorFlow / PyTorch never load; the app uses TF-IDF + heuristic fallbacks.
SEMANTIC_SEARCH_ENABLED=true
ENGAGEMENT_ML_ENABLED=true

# Allowed frontend origins (comma-separated), or "*" for any (dev only).
# Example: http://127.0.0.1:5500,http://localhost:5500
CORS_ORIGINS=*
